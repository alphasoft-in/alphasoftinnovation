---
import '../styles/global.css';
import CookieBanner from '../components/CookieBanner.jsx';
import WhatsAppButton from '../components/WhatsAppButton.jsx';

interface Props {
	title: string;
	description?: string;
}

const { 
	title, 
	description = "Transformamos y automatizamos tu empresa con software a medida, sistemas ERP/CRM, facturación electrónica SUNAT y desarrollo web de alto rendimiento en Perú."
} = Astro.props;

const fullTitle = title.includes("AlphaSoft") ? title : `${title} | AlphaSoft Innovation`;
const canonicalUrl = new URL(Astro.url.pathname, "https://www.alphasoftinnovation.com").toString();
const ogImageUrl = "https://www.alphasoftinnovation.com/android-chrome-512x512.png";
---

<!doctype html>
<html lang="es" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="keywords" content="desarrollo de software a medida, sistemas ERP Perú, CRM empresarial, automatización de procesos, diseño web corporativo, facturación electrónica SUNAT, ciencia de datos, consultoría TI, AlphaSoft Innovation, Lima, Perú" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<link rel="canonical" href={canonicalUrl} />
		<meta name="generator" content={Astro.generator} />

		<!-- Open Graph / WhatsApp / Facebook / LinkedIn -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="AlphaSoft Innovation" />
		<meta property="og:locale" content="es_PE" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:width" content="512" />
		<meta property="og:image:height" content="512" />
		<meta property="og:image:alt" content="AlphaSoft Innovation - Software a Medida y Sistemas Empresariales" />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={canonicalUrl} />
		<meta property="twitter:title" content={fullTitle} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={ogImageUrl} />
		
		<!-- Google Fonts: Inter (Optimized) -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link rel="preload" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" as="style" onload="this.onload=null;this.rel='stylesheet'">
		<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap"></noscript>
		
		<title>{fullTitle}</title>
	</head>
	<body class="bg-slate-950 text-slate-50 font-['Inter'] antialiased selection:bg-orange-500/30 overflow-x-hidden">
		<slot />
		<CookieBanner client:idle />
		<WhatsAppButton client:idle />
	</body>
</html>

<style is:global>
	/* Background glow effects */
	body::before {
		content: "";
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: radial-gradient(circle at 15% 50%, rgba(249, 115, 22, 0.14), transparent 25%),
					radial-gradient(circle at 85% 30%, rgba(220, 38, 38, 0.12), transparent 25%);
		z-index: -1;
		pointer-events: none;
	}

	/* Keep browser autofill dark */
	input:-webkit-autofill,
	input:-webkit-autofill:hover,
	input:-webkit-autofill:focus,
	textarea:-webkit-autofill,
	select:-webkit-autofill {
		-webkit-text-fill-color: #f8fafc;
		-webkit-box-shadow: 0 0 0px 1000px #020617 inset;
		transition: background-color 5000s ease-in-out 0s;
	}
</style>
