---
import '../styles/global.css';
import CookieBanner from '../components/CookieBanner.jsx';
import WhatsAppButton from '../components/WhatsAppButton.jsx';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="AlphaSoft Innovation Technology - Especialistas en diseño web, desarrollo de software y consultoría tecnológica a medida en Perú. Optimizamos empresas con tecnología vanguardista." />
		<meta name="keywords" content="ciencia de datos, data science, diseño web, páginas web, desarrollo de software, consultoría tecnológica, software a medida, facturación electrónica, minería, agricultura, AlphaSoft Innovation, Lima, Perú" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="canonical" href="https://alphasoftinnovation.com" />
		<meta name="generator" content={Astro.generator} />

		<!-- Open Graph / Facebook / LinkedIn -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://alphasoftinnovation.com/" />
		<meta property="og:title" content={`${title} | AlphaSoft Innovation`} />
		<meta property="og:description" content="Especialistas en desarrollo de software y consultoría tecnológica a medida en Perú. Optimizamos empresas con tecnología vanguardista." />
		<meta property="og:image" content="https://alphasoftinnovation.com/og-image.jpg" />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content="https://alphasoftinnovation.com/" />
		<meta property="twitter:title" content={`${title} | AlphaSoft Innovation`} />
		<meta property="twitter:description" content="Especialistas en desarrollo de software y consultoría tecnológica a medida en Perú. Optimizamos empresas con tecnología vanguardista." />
		<meta property="twitter:image" content="https://alphasoftinnovation.com/og-image.jpg" />
		
		<!-- Google Fonts: Inter (Optimized) -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link rel="preload" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" as="style" onload="this.onload=null;this.rel='stylesheet'">
		<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap"></noscript>
		
		<title>{title} | AlphaSoft Innovation</title>
	</head>
	<body class="bg-slate-950 text-slate-50 font-['Inter'] antialiased selection:bg-cyan-500/30">
		<slot />
		<CookieBanner client:idle />
		<WhatsAppButton client:idle />
	</body>
</html>

<style is:global>
	/* Background glow effects */
	body::before {
		content: "";
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: radial-gradient(circle at 15% 50%, rgba(6, 182, 212, 0.15), transparent 25%),
					radial-gradient(circle at 85% 30%, rgba(139, 92, 246, 0.15), transparent 25%);
		z-index: -1;
		pointer-events: none;
	}
</style>
