---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.jsx';
import Hero from '../components/Hero.jsx';
import ErpSection from '../components/ErpSection.jsx';
import MethodologyAndIndustries from '../components/MethodologyAndIndustries.jsx';
import Technologies from '../components/Technologies.jsx';
import Footer from '../components/Footer.jsx';
---

<Layout 
	title="AlphaSoft Innovation | Software a Medida, Sistemas ERP y Desarrollo Web" 
	description="Impulsa y automatiza tu empresa con sistemas ERP, CRM, facturación SUNAT y software a medida de alto rendimiento. Agenda tu diagnóstico tecnológico hoy."
>
	<Header client:load />
	<main>
		<Hero client:load />
		<MethodologyAndIndustries client:visible />
		<ErpSection client:visible />
		<Technologies client:visible />
	</main>
	<Footer />
</Layout>
