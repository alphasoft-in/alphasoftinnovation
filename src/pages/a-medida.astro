---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.jsx';
import Footer from '../components/Footer.jsx';
import CustomVsCms from '../components/CustomVsCms.jsx';
import CasesAndFaq from '../components/CasesAndFaq.jsx';
---

<Layout 
	title="Desarrollo de Software a Medida vs Plantillas Tradicionales | AlphaSoft Innovation" 
	description="Descubre por qué las empresas que escalan eligen ingeniería de software a medida: máxima velocidad, seguridad blindada y 0 cobros mensuales por licencias."
>
	<Header client:load />
	<main class="pt-24 pb-0">
		<CustomVsCms client:visible />
		<CasesAndFaq client:visible />
	</main>
	<Footer />
</Layout>
